# ---------- Server ----------
NODE_ENV=production
# Native install: keep 127.0.0.1 and put Nginx in front. Docker sets 0.0.0.0 itself.
HOST=127.0.0.1
PORT=3000
# Express "trust proxy" setting. "loopback" is right when Nginx runs on the same host.
TRUST_PROXY=loopback

# ---------- Provider ----------
# cli = Gemini CLI on this server, signed in with your Google account (private use)
# api = official Gemini API with an API key (use this for public deployments)
GEMINI_PROVIDER=cli

# CLI provider
GEMINI_COMMAND=gemini
GEMINI_TIMEOUT_MS=120000
# Optional: force a model, e.g. gemini-2.5-pro (empty = CLI default)
GEMINI_MODEL=
# Optional: "plan" = read-only tools (needs a recent CLI). Empty = CLI default (tools needing approval are denied).
GEMINI_APPROVAL_MODE=plan
# Optional fixed working directory for the CLI. Empty = a fresh empty temp dir per request.
GEMINI_WORKDIR=

# API provider
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.5-flash

# ---------- Limits ----------
MAX_PROMPT_CHARS=8000
MAX_BODY_SIZE=64kb
MAX_CONCURRENT_REQUESTS=2
MAX_QUEUE_SIZE=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Comma-separated extra origins allowed to call the API cross-origin (same-origin always works).
CORS_ORIGINS=

# Logging: prompts are NOT logged unless this is true.
LOG_PROMPTS=false
